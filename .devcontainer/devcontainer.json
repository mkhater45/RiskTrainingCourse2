{
  "name": "Python & SQL Risk Analytics Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.interactiveWindow.intro.show": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-powertoys",
        "ms-toolsai.datawrangler"
      ]
    }
  },
  
  // 1. Runs during prebuild: Pre-installs packages and bakes the 1.1 GB file into the background image snapshot
  "onCreateCommand": "pip install --upgrade pip && pip install ipykernel pandas polars duckdb openpyxl pyarrow numpy matplotlib && sudo mkdir -p /workspace_data_cache && sudo curl -L -o /workspace_data_cache/risk.duckdb 'https://tahastorage.blob.core.windows.net/training-public/risk.duckdb'",

  // 2. Runs instantly at startup: Moves the cached file from the image into your live workspace folder
  "postCreateCommand": "cp /workspace_data_cache/risk.duckdb ${containerWorkspaceFolder}/risk.duckdb"
}
