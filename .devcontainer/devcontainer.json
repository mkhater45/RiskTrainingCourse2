{
  "name": "Python & SQL Risk Analytics Lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.interactiveWindow.intro.show": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-powertoys",
        "randomfractions.data-wrangler"
      ]
    }
  },

  // Installs the modern analytical stack (no heavy zips/unzipping needed!)
  "postCreateCommand": "pip install --upgrade pip && pip install pandas polars duckdb pyarrow numpy matplotlib"
}
